# =============================================================
# Backend environment variables
# Copy this file to `.env` (same directory) and fill in values.
# NEVER commit the real `.env` file - it is git-ignored.
# Docker Compose reads `.env` automatically.
# For running Spring Boot locally (mvnw spring-boot:run), set these
# as OS environment variables or in your IDE run configuration.
# =============================================================

# --- Database (local dev default: postgres/postgres) ---
DB_USERNAME=postgres
DB_PASSWORD=

# --- Database - cloud deployment with Neon (set these on Render, not locally) ---
# Neon has NO "API key" for the app - it gives a normal Postgres connection string:
#   postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/DBNAME?sslmode=require
# Split it into these variables (Neon requires SSL -> DB_SSLMODE=require):
# DB_HOST=ep-xxx.ap-southeast-1.aws.neon.tech
# DB_PORT=5432
# DB_NAME=
# DB_SSLMODE=require

# --- Redis - cloud deployment with Upstash (set these on Render, not locally) ---
# Upstash (upstash.com) -> create Redis database -> copy endpoint + password.
# Upstash requires TLS -> REDIS_SSL=true
# REDIS_HOST=xxx.upstash.io
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_SSL=true

# --- JWT (required in prod; generate 64+ random chars, e.g. `openssl rand -base64 64`) ---
JWT_SECRET=

# --- Cloudinary (Dashboard -> Settings -> Access Keys) ---
CLOUDINARY_CLOUD_NAME=dxxdhz5f5
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- PayPal sandbox (developer.paypal.com -> Apps & Credentials) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# 1 USD = this many VND, used to convert order totals for PayPal checkout
PAYPAL_EXCHANGE_RATE=25000
# Subscriptions (SaaS billing) - webhook id from Apps & Credentials -> Webhooks;
# plan ids from the one-time Catalog Products/Billing Plans setup (see TODO.md)
PAYPAL_WEBHOOK_ID=
PAYPAL_BASIC_PLAN_ID=
PAYPAL_PRO_PLAN_ID=

# --- MoMo sandbox (developers.momo.vn/v3/vi/docs/payment/onboarding/test-instructions/)
# These are MoMo's own publicly documented SHARED test credentials - no merchant
# registration needed for sandbox. Get real ones from business.momo.vn before going live. ---
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=F8BBA842ECF85
MOMO_SECRET_KEY=K951B6PE1waDMi640xX08PD3vg6EkVlz
MOMO_ENDPOINT=https://test-payment.momo.vn

# --- SePay: VietQR bank transfer through YOUR OWN linked bank account (no
# merchant registration - SePay just watches that account and webhooks this
# backend on incoming AND outgoing transfers, the latter for refund
# detection - see PaymentController). Register at my.sepay.vn, link a bank,
# then Tích hợp WebHooks -> "+ Thêm webhook" -> URL =
# {APP_BACKEND_URL}/payments/webhook/sepay, loại giao dịch = Tất cả,
# Bảo mật = HMAC-SHA256 (SePay's own recommended method) - the Secret Key
# shown there is SEPAY_WEBHOOK_SECRET below. ---
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=BIDV
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_SECRET=

# --- This backend's own public URL (used to build MoMo's IPN callback URL) -
# must be the real Render URL in production, not localhost, same class of
# footgun as APP_FRONTEND_URL above ---
APP_BACKEND_URL=http://localhost:8081/api

# --- Email: Brevo HTTP API - primary (brevo.com -> Settings -> SMTP & API -> API Keys) ---
# Works on Render (SMTP ports are blocked there). Free: 300 emails/day.
BREVO_API_KEY=

# --- Email: Gmail SMTP - fallback, only works local/VPS (NOT on Render) ---
# MAIL_PASSWORD is a Gmail App Password (myaccount.google.com -> Security -> App passwords)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- AI - DeepSeek only (platform.deepseek.com -> API Keys) ---
DEEPSEEK_API_KEY=

# --- CORS (comma-separated frontend origins) ---
CORS_ORIGINS=http://localhost:3000

# --- Frontend URL used to build links this backend sends out (staff invite
# emails, PayPal return/cancel URLs) - set the real domain on Render, not localhost ---
APP_FRONTEND_URL=http://localhost:3000

# =============================================================
# VN payment gateways - Phase 2.4 (NOT wired into code yet).
# Uncomment when the integration lands. Register sandbox accounts:
# =============================================================

# --- VNPay sandbox (register: sandbox.vnpayment.vn/devreg) ---
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return

# --- MoMo test environment (no registration needed - public test credentials
#     are published in the docs at developers.momo.vn; grab the latest values) ---
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=
# MOMO_ENDPOINT=https://test-payment.momo.vn

# --- PayOS - VietQR bank transfer (register: my.payos.vn) ---
# REJECTED (01/09/2026): requires real CCCD/business-tax-code verification
# at registration, no sandbox to fake it with - not worth it for a demo
# project. Use SEPAY_* above instead (active section, no such requirement).
